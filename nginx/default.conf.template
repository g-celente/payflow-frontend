# Processado pelo envsubst da imagem oficial do nginx: só ${BFF_URL} e ${GATEWAY_ORIGIN_SECRET} são trocados.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Mesmo papel do proxy do Vite: o navegador chama /api/* e o nginx repassa ao BFF sem o prefixo.
    location /api/ {
        proxy_pass ${BFF_URL}/;
        proxy_set_header X-Gateway-Secret "${GATEWAY_ORIGIN_SECRET}";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # remoteEntry.js e index.html nunca ficam em cache: uma versão nova de um remote vale na hora.
    location ~ (remoteEntry\.js|index\.html)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Arquivos com hash no nome: cache longo.
    location ~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /mfe-payments/ {
        try_files $uri =404;
    }

    location /mfe-account/ {
        try_files $uri =404;
    }

    # SPA: qualquer outra rota (/pagamentos/..., /conta/...) abre o Shell.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
