# Copie para .env (na raiz do repositório; os três apps leem daqui). Nada aqui é segredo de usuário.

# ---- Navegador (entram no build; prefixo VITE_) ----
# Localmente, /api passa pelo proxy do Vite até o BFF. Na nuvem: URL do API Gateway, ex.:
# https://<id>.execute-api.sa-east-1.amazonaws.com/prod/api
VITE_API_BASE_URL=/api
# Chave do usage plan do API Gateway (identifica o portal). Vazio localmente.
VITE_GATEWAY_API_KEY=
# remoteEntry.js de cada microfrontend. Na nuvem: https://<cloudfront>/mfe-payments/remoteEntry.js
VITE_MFE_PAYMENTS_URL=http://localhost:5174/remoteEntry.js
VITE_MFE_ACCOUNT_URL=http://localhost:5175/remoteEntry.js

# ---- Build (onde cada app é publicado) ----
# Na nuvem: SHELL_BASE=/shell/ e MFE_*_BASE=https://<cloudfront>/mfe-payments/ (absoluto: os arquivos são baixados pela página do Shell)
SHELL_BASE=/
MFE_PAYMENTS_BASE=http://localhost:5174/
MFE_ACCOUNT_BASE=http://localhost:5175/

# ---- Só no proxy de desenvolvimento (nunca vão para o navegador) ----
BFF_DEV_URL=http://localhost:3000
# Se o BFF exigir o cabeçalho do API Gateway (GATEWAY_ORIGIN_SECRET), o proxy envia o mesmo valor.
GATEWAY_ORIGIN_SECRET=
